{
  "functions": {
    "api/scan.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reset-demo",
      "schedule": "0 21 * * *"
    }
  ]
}
